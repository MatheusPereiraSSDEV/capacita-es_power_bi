model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_calendario","dim_canal","dim_cliente","dim_produto","fato_metas","fato_vendas","Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_calendario
ref table dim_canal
ref table dim_cliente
ref table dim_produto
ref table fato_metas
ref table fato_vendas
ref table Medidas

ref cultureInfo pt-BR

