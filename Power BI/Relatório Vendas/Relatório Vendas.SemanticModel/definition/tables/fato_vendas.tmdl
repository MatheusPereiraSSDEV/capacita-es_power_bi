table fato_vendas
	lineageTag: ecce8098-9e83-4f29-9781-22c33ae2b564

	measure Medida = SUM(fato_vendas[quantidade]) * SUM(fato_vendas[valor_unitario])
		lineageTag: f760f8ba-abbf-440c-8e3d-9acbf3c9b0c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Venda' =
			
			SUMX(
			    fato_vendas,
			    fato_vendas[quantidade] * fato_vendas[valor_unitario]
			)
		lineageTag: 3f622d89-269b-47da-bc79-ee774d94db4d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Venda App' =
			
			CALCULATE(
			    [Total Venda],
			    // FILTER(
			    //     fato_vendas,
			    //     fato_vendas[sk_canal] = 1
			    // )
			    FILTER(
			        dim_canal,
			        dim_canal[sk_canal] = 1
			    )--,
			    // KEEPFILTERS(fato_vendas[sk_canal] = 1)
			)
		lineageTag: e1d8293c-2807-4cab-9427-a7ff9ae6c931

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Venda App 2' =
			
			CALCULATE(
			    [Total Venda],
			    dim_canal[sk_canal] = 1
			)
		lineageTag: 0555e725-f9cd-4b42-9c06-0d8093ac087f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

